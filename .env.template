#Address where to find the Musikcube server (e.g. 192.168.1.40)
VITE_MUSIKCUBE_SERVER_ADDRESS=

#Port for the Metadata Server. Default is 7905
#VITE_MUSIKCUBE_METADATASERVER_PORT=

#Passwort for the server. If the Server uses a passwort, uncomment and set the passwort
#VITE_MUSIKCUB_PASSWORD=

#Address where to find the proxy to get musik-data (e.g. http://192.168.1.40)
VITE_MUSIKCUBE_PROXY_ADDRESS=

#Port for the proxy. Default will be 5000
#VITE_MUSIKCUBE_PROXY_PORT=

